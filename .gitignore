# Go / Wails build output — generated by `wails build` (build.ps1)
build/bin/

# Bundled ffmpeg / ffprobe third-party binaries — downloaded per-platform,
# not source; fetched or provided at packaging time
build/ffmpeg/

# Frontend build output — generated by `vite build` via wails
frontend/dist/*
# Placeholder kept so `go:embed all:frontend/dist` compiles before first build
!frontend/dist/.gitkeep

# Frontend dependencies (pnpm)
frontend/node_modules/
frontend/package.json.md5

# AI coding agent local state
.atomcode/

# Generated commit message (never committed)
COMMIT.md

# IDE
.idea/

# OS junk
Thumbs.db
.DS_Store
